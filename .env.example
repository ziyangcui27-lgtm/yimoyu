# ============================================
# 熠墨雨 环境变量模板
# 复制本文件为 .env 并填入真实凭据：
#   cp .env.example .env
# 注意：.env 含密钥，已被 .gitignore 排除，绝不上传仓库
# ============================================

# 魔珐星云 应用 ID（必填）
VITE_APP_ID=your_app_id

# 魔珐星云 应用密钥（必填）
VITE_APP_SECRET=your_app_secret

# 网关地址（一般无需修改）
VITE_GATEWAY=https://nebula-agent.xingyun3d.com/user/v1/ttsa_v2/session
